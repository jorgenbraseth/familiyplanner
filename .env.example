# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (platform.claude.com, workspace "family-planner")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_EXTRACT=claude-sonnet-5-5
ANTHROPIC_MODEL_ASSISTANT=claude-haiku-5-5

# Google service account JSON key, base64-encoded on one line
GOOGLE_SERVICE_ACCOUNT_KEY=

# Web push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jorgen.braseth@gmail.com

# Limits
ASSISTANT_DAILY_LIMIT_PER_CHILD=30
STAR_REQUESTS_DAILY_LIMIT=5
